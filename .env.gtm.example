# Copy this file to gtm/.env and fill in the values there.
# gtm/.env is gitignored. Do not put real keys in this file.
# Do not commit gtm/.env or any copy that contains a real key.

# OpenAI. The bootstrap stores this key in Onyx through the admin API.
# Leave the model lines unset to use gpt-4.1 and gpt-4.1-mini.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=
OPENAI_FAST_MODEL=

# Match this to an OpenAI provider you already created in the Onyx wizard.
# Leave it unset to create or update the provider named "PushPress OpenAI".
GTM_OPENAI_PROVIDER_NAME=

# Notion internal integration token. Create the integration in Notion,
# share the GTM space with it, then paste the token here.
# Optional. Leave unset to index every page the integration can read.
NOTION_INTEGRATION_TOKEN=
NOTION_ROOT_PAGE_ID=

# Onyx. Create the API key in the admin UI while you are logged in as an admin.
# The key starts with on_.
# ONYX_API_BASE includes the /api prefix that nginx and the dev web server strip.
# Direct to the API process, with no web server: http://localhost:8080
ONYX_API_BASE=http://localhost:3000/api
ONYX_API_KEY=

# Timeouts in seconds. Chat evals wait longer than admin calls.
ONYX_HTTP_TIMEOUT=60
ONYX_CHAT_TIMEOUT=180

# Set to true to ask Onyx for an incognito eval session.
# Leave unset. Onyx rejects the flag when incognito is off.
GTM_EVAL_INCOGNITO=

# Access evals (python3 gtm/evals/run_evals.py --access). Personal access
# tokens, not the admin API key. Leave unset until those users exist.
# ONYX_MCP_URL defaults to the host of ONYX_API_BASE with /mcp.
ONYX_HUB_USER_TOKEN=
ONYX_INFORMATICS_VIEWER_TOKEN=
ONYX_REVOKED_TOKEN=
ONYX_MCP_URL=
